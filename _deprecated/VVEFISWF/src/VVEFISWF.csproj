<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>VVEFISWF</AssemblyName>
    <RootNamespace>VVEFISWF</RootNamespace>
    <Version>0.2.0</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source-linked shared basket (same pattern as VVEFIS.csproj, see
         src/Shared/DangItBridge.cs header for the rationale): DangIt/FAR/
         RealBattery readers, the Tier scale, mod-presence checks, AND (as of
         2026-09-01) the EFIS severity computation itself (VVEFISSeverity.cs)
         are compiled INTO this DLL from MFDExtension's own src/Shared/ - no
         runtime dependency on VVEFIS.dll, so this "EFIS WF" twin stays a
         physically separate, independently uninstallable plugin (delete this
         whole Extras/VVEFISWF/ folder and VVEFIS/EFIS SEVERITY keeps working
         untouched, and vice versa) while computing the EXACT same tier/color
         logic as its sibling instead of a copy-pasted, driftable one. -->
    <Compile Include="..\..\..\src\Shared\*.cs">
      <Link>Shared\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Stock KSP/Unity references. Extras/VVEFISWF/src is 5 levels below the
         KSP install root (Extras\VVEFISWF\src\ -> MFDExtension\ -> GameData\ -> root). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VesselView/VesselViewRPM: the whole point of this satellite, a real (not
         reflection-based) dependency - see VVEFISWFAddon.cs for why touching
         these types is still guarded behind a runtime AssemblyLoader check. -->
    <Reference Include="VesselView">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselView.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewRPM">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselViewRPM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewPlugin">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselViewPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy into its OWN payload folder, sibling to (not inside) Extras/VVEFIS/ -
       a separate DLL in a separate folder, so the player can delete this one
       and keep the solid-fill mode, or vice versa. -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\..\GameData\MFDExtension\Extras\VVEFISWF\" />
  </Target>

</Project>
