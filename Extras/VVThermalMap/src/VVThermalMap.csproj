<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>VVThermalMap</AssemblyName>
    <RootNamespace>VVThermalMap</RootNamespace>
    <Version>0.3.0</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unlike VVEFIS, this satellite has no severity/arbitration logic - no
         DangIt/FAR/RealBattery/Tier/FuelEngineReader involved (see
         Extras/VVThermalMap/CLAUDE.md design principles: pure skin-temperature
         overlay, independent of VVEFISSeverity). Only ModPresence.cs is
         actually needed, for the same "is VesselViewRPM loaded?" check
         VVEFISAddon uses - so only that one file is source-linked, not the
         whole Shared/*.cs basket. -->
    <Compile Include="..\..\..\src\Shared\ModPresence.cs">
      <Link>Shared\ModPresence.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Stock KSP/Unity references. Extras/VVThermalMap/src is 5 levels below
         the KSP install root (Extras\VVThermalMap\src\ -> MFDExtension\ ->
         GameData\ -> root). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\..\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VesselView/VesselViewRPM: same real (not reflection-based) dependency
         as VVEFIS, for the same reason - registering a custom color mode
         needs the real types. See VVEFISAddon.cs for why touching these
         types must stay guarded behind a runtime AssemblyLoader check. -->
    <Reference Include="VesselView">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselView.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewRPM">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselViewRPM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewPlugin">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\..\VesselView\Plugins\VesselViewPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the plugin DLL into MFDExtension's own Extras/ payload area, not
       Plugins/ (that one is reserved for a possible future MFDExtension.dll
       itself - see CLAUDE.md). -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\..\GameData\MFDExtension\Extras\VVThermalMap\" />
  </Target>

</Project>
