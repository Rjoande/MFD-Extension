<Project>
  <PropertyGroup>
    <!-- Keep MSBuild intermediates off the exFAT game drive (1 MB clusters waste space on small files). -->
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\VVHolo\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\VVHolo\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
