<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>VVHolo</AssemblyName>
    <RootNamespace>VVHolo</RootNamespace>
    <Version>0.4.2</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- KSP install the reference assemblies come from. Defaults to the game
         root five levels up (the repo living in <KSP>/GameData/MFD-Extension); when
         the repo lives elsewhere - it does since 2026-09-18, E:\Giochi\KSP\Mods -
         pass it explicitly, same convention as KRAB/KRILL/SA:
             dotnet build -c Release -p:KspRoot="E:\path\to\KSP" -->
    <KspRoot Condition="'$(KspRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..</KspRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unlike VVThermalMap (only ModPresence.cs), this satellite needs the
         WHOLE shared basket, same as VVEFIS: VVHoloPalette classifies a part
         via VVEFISSeverity.GetStatus(part).Tier (the same WARNING/CAUTION
         arbitration across DangIt/FAR/RealBattery/fuel/engine already
         computed there), which itself depends on DangItBridge/FARBridge/
         RealBatteryBridge/FuelEngineReader/Tier - it doesn't reuse
         VVEFISSeverity's own colors, only its tier classification. -->
    <Compile Include="..\..\..\src\Shared\*.cs">
      <Link>Shared\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Stock KSP/Unity references. Extras/VVHolo/src is 5 levels below the
         KSP install root (Extras\VVHolo\src\ -> MFDExtension\ -> GameData\
         -> root). -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VesselView/VesselViewRPM: same real (not reflection-based) dependency
         as VVEFIS/VVThermalMap, for the same reason - registering a custom
         color mode needs the real types. See VVEFISAddon.cs for why touching
         these types must stay guarded behind a runtime AssemblyLoader check. -->
    <Reference Include="VesselView">
      <HintPath>$(KspRoot)\GameData\VesselView\Plugins\VesselView.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewRPM">
      <HintPath>$(KspRoot)\GameData\VesselView\Plugins\VesselViewRPM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VesselViewPlugin">
      <HintPath>$(KspRoot)\GameData\VesselView\Plugins\VesselViewPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the plugin DLL into MFDExtension's own Extras/ payload area, not
       Plugins/ (that one is reserved for a possible future MFDExtension.dll
       itself - see CLAUDE.md). -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\..\GameData\MFDExtension\Extras\VVHolo\" />
  </Target>

</Project>
