# Build artifacts (Directory.Build.props already redirects obj/bin outside
# this folder, onto C:, for exFAT reasons — these entries are just a safety
# net in case that ever changes, or for anyone building without that props file).
src/obj/
src/bin/
src/.vs/

# Internal development material — design decisions, research handoff notes,
# the Claude Code project hub — not part of the shipped mod, kept local only.
notes/
CLAUDE.md

# Texture working files: only the exported .png ships with the mod.
GameData/MFDExtension/Textures/*.psd

# OS/editor cruft
.DS_Store
Thumbs.db
