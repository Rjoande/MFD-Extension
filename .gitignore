# Build artifacts (Directory.Build.props already redirects obj/bin outside
# this folder, onto C:, for exFAT reasons — these entries are just a safety
# net in case that ever changes, or for anyone building without that props file).
src/obj/
src/bin/
src/.vs/

# Internal development material — design decisions, research handoff notes,
# the Claude Code project hubs — not part of the shipped mod, kept local only.
# No leading slash: the hub of a satellite (Extras/VVHolo/CLAUDE.md and the
# like) is ignored at any depth, not just the one in the root.
notes/
CLAUDE.md
ReleaseNote.md

# Texture working files: only the exported .png ships with the mod.
GameData/MFDExtension/Textures/*.psd

# OS/editor cruft
.DS_Store
Thumbs.db

# Packaged release archives — built from the tracked source, not source
# themselves; distributed via GitHub Releases, not the repo tree.
*.zip
