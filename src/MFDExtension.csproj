<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12.5 runs Unity 2019.4 / Mono: target .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>MFDExtension</AssemblyName>
    <RootNamespace>MFDExtension</RootNamespace>
    <Version>0.4.2</Version>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- KSP install the reference assemblies come from. Defaults to the game
         root three levels up (the repo living in <KSP>/GameData/MFD-Extension); when
         the repo lives elsewhere - it does since 2026-09-18, E:\Giochi\KSP\Mods -
         pass it explicitly, same convention as KRAB/KRILL/SA:
             dotnet build -c Release -p:KspRoot="E:\path\to\KSP" -->
    <KspRoot Condition="'$(KspRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..</KspRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against reference assemblies even without a local targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal on purpose: this project talks to RPM/MAS by reflection only
         (no RPM.dll/MAS.dll reference), per the shared-framework design notes.
         Add UGUI/ToolbarControl references here only if/when a desktop
         toolbar window is added — not needed for prop/page handlers. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the plugin DLL into the mod folder KSP actually loads —
       the nested GameData/MFDExtension/ payload (mirrors the GitHub repo's own
       GameData/MFDExtension/ layout), same convention as KRAB/KRILL. -->
  <Target Name="DeployToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\MFDExtension\Plugins\" />
  </Target>

</Project>
